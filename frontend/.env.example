# Base URL of the LUMA backend (Node 2). The dev server picks up a change by itself.
# Local backend:        http://localhost:8000
# A teammate's backend: http://<their current LAN IP>:8000 — it changes with the Wi-Fi;
#                       see "Connecting to a backend" in README.md
VITE_API_BASE_URL=http://localhost:8000
